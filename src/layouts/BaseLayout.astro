---
import '../styles/global.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_URL } from '../config';
import { sk } from '../i18n/sk';

interface Props {
  title?: string;
  description?: string;
}

const { title = sk.meta.defaultTitle, description = sk.meta.defaultDescription } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageURL = new URL(sk.meta.ogImagePath, SITE_URL).href;
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sk.meta.ogSiteName} />
    <meta property="og:locale" content={sk.meta.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(sk.meta.ogImageWidth)} />
    <meta property="og:image:height" content={String(sk.meta.ogImageHeight)} />
    <meta property="og:image:alt" content={sk.meta.ogImageAlt} />

    <meta name="twitter:card" content={sk.meta.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <AnnouncementBar />
    <SiteHeader />
    <main class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
