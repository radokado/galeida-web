---
import { sk } from '../i18n/sk';

const sectionHeadingId = 'funkcie-heading';
---

<section class="features" id="funkcie" aria-labelledby={sectionHeadingId}>
  <h2 class="sr-only" id={sectionHeadingId}>{sk.features.sectionTitle}</h2>

  <ul class="features__list">
    <li class="features__item">
      <svg
        class="features__icon"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M7 20.5c-2-1.8-2.8-5-1.5-8 1.4-3.5 5-5.5 9-5.5 2.2 0 4.2.9 5.5 2.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M20 14.5c.8 1.2.9 2.8.2 4.2-.8 1.6-2.4 2.8-4.2 3.3-2.2.6-4.6.2-6.5-1.2"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M13.5 11.5c-.5-.55-1.35-.55-1.85 0-.5.55-.5 1.4 0 1.95l1.85 1.95 1.85-1.95c.5-.55.5-1.4 0-1.95-.5-.55-1.35-.55-1.85 0Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"></path>
      </svg>
      <div class="features__text">
        <h3 class="features__title">{sk.features.items[0].title}</h3>
        <p class="features__desc">{sk.features.items[0].description}</p>
      </div>
    </li>
    <li class="features__item">
      <svg
        class="features__icon"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <rect
          x="4"
          y="5"
          width="16"
          height="14"
          rx="2"
          stroke="currentColor"
          stroke-width="1.5"></rect>
        <path
          d="M4 15l4.5-4 3 2.5L16 9l4 4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <circle cx="9" cy="9" r="1.25" fill="currentColor"></circle>
      </svg>
      <div class="features__text">
        <h3 class="features__title">{sk.features.items[1].title}</h3>
        <p class="features__desc">{sk.features.items[1].description}</p>
      </div>
    </li>
    <li class="features__item">
      <svg
        class="features__icon"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M7 14a4.5 4.5 0 0 1 9 0v.5c0 1.4 1.1 2.5 2.5 2.5H19a2 2 0 0 1 2 2v.5a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-.5a2 2 0 0 1 2-2h.5c1.4 0 2.5-1.1 2.5-2.5V14Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"></path>
        <path
          d="M5 5l14 14"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
      <div class="features__text">
        <h3 class="features__title">{sk.features.items[2].title}</h3>
        <p class="features__desc">{sk.features.items[2].description}</p>
      </div>
    </li>
  </ul>
</section>
