---
import { sk } from '../i18n/sk';

const headingId = 'highlights-heading';
---

<section class="highlights" aria-labelledby={headingId}>
  <div class="container">
    <h2 class="sr-only" id={headingId}>{sk.highlights.sectionTitle}</h2>

    <ul class="highlights__grid">
      <li class="highlights__card highlights__card--neutral">
        <svg
          class="highlights__icon"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <rect
            x="7"
            y="3"
            width="10"
            height="18"
            rx="2"
            stroke="currentColor"
            stroke-width="1.5"></rect>
          <path
            d="M10 6h4M12 17v3M12 20h.01"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
          <path
            d="M12 8v5M9.5 12.5 12 15l2.5-2.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <h3 class="highlights__title">{sk.highlights.items[0].title}</h3>
        <p class="highlights__desc">{sk.highlights.items[0].description}</p>
      </li>
      <li class="highlights__card highlights__card--peach">
        <svg
          class="highlights__icon"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M12 8v13M12 8c-1.5 0-3-1.2-3-3.2S10.5 2 12 2s3 1.6 3 2.8S13.5 8 12 8Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M5.5 11.5 12 15l6.5-3.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M4 11h16v2.5c0 2.2-1.8 4-4 4h-8c-2.2 0-4-1.8-4-4V11Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
        <h3 class="highlights__title">{sk.highlights.items[1].title}</h3>
        <p class="highlights__desc">{sk.highlights.items[1].description}</p>
      </li>
      <li class="highlights__card highlights__card--sage">
        <svg
          class="highlights__icon"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M12 3 5 6v5c0 4.5 3 8.7 7 10 4-1.3 7-5.5 7-10V6l-7-3Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
          <path
            d="m9 12 2 2 4-4.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <h3 class="highlights__title">{sk.highlights.items[2].title}</h3>
        <p class="highlights__desc">{sk.highlights.items[2].description}</p>
      </li>
    </ul>
  </div>
</section>
